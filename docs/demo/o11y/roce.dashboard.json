      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "RoCE share of traffic",
      "description": "Fraction of all egress traffic on the selected ports that rides the RoCE queue.",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "datasource": "VictoriaMetrics",
          "refId": "A",
          "expr": "sum(fabric_agent_interface_queue_transmit_bits_per_second{hostname=~\"$switch\", interface=~\"$interface\", interface!~\"CPU|M[0-9]+\", queue=\"$roce_queue\"}) / sum(fabric_agent_interface_queue_transmit_bits_per_second{hostname=~\"$switch\", interface=~\"$interface\", interface!~\"CPU|M[0-9]+\"})",
          "legendFormat": "share"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          },
          "decimals": 1,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "ECN marks",
      "description": "ECN-marked packets on the RoCE queue in the time range. 0 = no congestion signalled.",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "h": 5,
        "w": 2,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "datasource": "VictoriaMetrics",
          "refId": "A",
          "expr": "sum(increase(fabric_agent_interface_queue_ecn_marked_pkts{hostname=~\"$switch\", interface=~\"$interface\", interface!~\"CPU|M[0-9]+\", queue=\"$roce_queue\"}[$__range]))",
          "legendFormat": "ecn",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Drops",
      "description": "Packets dropped (tail + WRED) on the RoCE queue in the time range. Lossless class: should stay 0.",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "h": 5,
        "w": 2,
        "x": 22,
        "y": 1
      },
      "targets": [
        {
          "datasource": "VictoriaMetrics",
          "refId": "A",
          "expr": "(sum(increase(fabric_agent_interface_queue_dropped_pkts{hostname=~\"$switch\", interface=~\"$interface\", interface!~\"CPU|M[0-9]+\", queue=\"$roce_queue\"}[$__range])) or vector(0)) + (sum(increase(fabric_agent_interface_queue_wred_dropped_pkts{hostname=~\"$switch\", interface=~\"$interface\", interface!~\"CPU|M[0-9]+\", queue=\"$roce_queue\"}[$__range])) or vector(0))",
          "legendFormat": "drops",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false

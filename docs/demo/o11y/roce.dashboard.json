{
  "title": "Hedgehog RoCE",
  "uid": "hh-roce",
  "tags": [
    "hedgehog",
    "roce"
  ],
  "description": "RoCE traffic as seen by the fabric switches: lossless-queue throughput, ECN marks, drops and buffer watermarks per switch port.",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "10s",
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "switch",
        "label": "Switch",
        "description": "Switches to include",
        "type": "query",
        "datasource": "VictoriaMetrics",
        "query": {
          "query": "label_values(fabric_agent_interface_queue_transmit_pkts, hostname)",
          "refId": "switch"
        },
        "definition": "label_values(fabric_agent_interface_queue_transmit_pkts, hostname)",
        "refresh": 2,
        "sort": 1,
        "regex": "",
        "multi": true,
        "includeAll": true,
        "hide": 0,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "interface",
        "label": "Port",
        "description": "Switch ports to include",
        "type": "query",
        "datasource": "VictoriaMetrics",
        "query": {
          "query": "label_values(fabric_agent_interface_queue_transmit_pkts{hostname=~\"$switch\", interface!~\"CPU|M[0-9]+\"}, interface)",
          "refId": "interface"
        },
        "definition": "label_values(fabric_agent_interface_queue_transmit_pkts{hostname=~\"$switch\", interface!~\"CPU|M[0-9]+\"}, interface)",
        "refresh": 2,
        "sort": 1,
        "regex": "",
        "multi": true,
        "includeAll": true,
        "hide": 0,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "roce_queue",
        "label": "RoCE queue",
        "description": "Lossless unicast queue RoCE traffic is mapped to (UC3 with Hedgehog's RoCE QoS)",
        "type": "query",
        "datasource": "VictoriaMetrics",
        "query": {
          "query": "label_values(fabric_agent_interface_queue_transmit_pkts{hostname=~\"$switch\"}, queue)",
          "refId": "roce_queue"
        },
        "definition": "label_values(fabric_agent_interface_queue_transmit_pkts{hostname=~\"$switch\"}, queue)",
        "refresh": 2,
        "sort": 1,
        "regex": "/^UC\\d+$/",
        "multi": false,
        "includeAll": false,
        "hide": 0,
        "current": {
          "text": "UC3",
          "value": "UC3"
        }
      },
      {
        "name": "topn",
        "label": "Top N",
        "description": "How many ports to show in per-port panels",
        "type": "custom",
        "query": "5,10,20",
        "multi": false,
        "includeAll": false,
        "hide": 0,
        "current": {
          "text": "10",
          "value": "10"
        },
        "options": [
          {
            "selected": false,
            "text": "5",
            "value": "5"
          },
          {
            "selected": true,
            "text": "10",
            "value": "10"
          },
          {
            "selected": false,
            "text": "20",
            "value": "20"
          }
        ]
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "RoCE throughput",
      "description": "RoCE traffic leaving the selected switch ports on the RoCE queue (switch egress = traffic delivered to the attached devices).",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": "VictoriaMetrics",
          "refId": "A",
          "expr": "sum(fabric_agent_interface_queue_transmit_bits_per_second{hostname=~\"$switch\", interface=~\"$interface\", interface!~\"CPU|M[0-9]+\", queue=\"$roce_queue\"})",
          "legendFormat": "RoCE"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {

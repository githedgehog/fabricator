          "refId": "A",
          "expr": "topk_max($topn, sum by (hostname, interface) (rate(fabric_agent_interface_queue_dropped_pkts{hostname=~\"$switch\", interface=~\"$interface\", interface!~\"CPU|M[0-9]+\", queue=\"$roce_queue\"}[$__rate_interval]) + rate(fabric_agent_interface_queue_wred_dropped_pkts{hostname=~\"$switch\", interface=~\"$interface\", interface!~\"CPU|M[0-9]+\", queue=\"$roce_queue\"}[$__rate_interval])))",

      "targets": [
        {
          "datasource": "VictoriaMetrics",
          "refId": "A",
          "expr": "count(fabric_agent_interface_queue_transmit_bits_per_second{hostname=~\"$switch\", interface=~\"$interface\", interface!~\"CPU|M[0-9]+\", queue=\"$roce_queue\"} > 1e6) or vector(0)",

    {
      "id": 10,
      "type": "timeseries",
      "title": "RoCE throughput per port (top $topn)",
      "description": "RoCE-queue egress per switch port, i.e. RoCE traffic delivered to the device on that port.",
      "datasource": "VictoriaMetrics",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "datasource": "VictoriaMetrics",
          "refId": "A",
          "expr": "topk_max($topn, sum by (hostname, interface) (fabric_agent_interface_queue_transmit_bits_per_second{hostname=~\"$switch\", interface=~\"$interface\", interface!~\"CPU|M[0-9]+\", queue=\"$roce_queue\"}))",
          "legendFormat": "{{hostname}} {{interface}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "noValue": "0",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "smooth",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
